# Database
DATABASE_URL=postgresql://user:password@host:port/database
ConnectionStrings__DefaultConnection=Host=localhost;Database=devlivery;Username=postgres;Password=postgres

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5000

# JWT Authentication
JwtTokenSettings__Issuer=devlivery.webapi
JwtTokenSettings__Audience=devlivery.app
JwtTokenSettings__ExpirationInMinutes=60
JwtTokenSettings__SecretKey=YOUR-SECURE-SECRET-KEY-MIN-32-CHARS-GENERATE-NEW-ONE

# CORS - Separar múltiplas origens com vírgula
# Desenvolvimento: http://localhost:5173
# Produção: https://seu-app.railway.app
ALLOWED_ORIGINS=http://localhost:5173

# Railway Specific (automaticamente configurado)
# PORT=5000
# RAILWAY_ENVIRONMENT=production
