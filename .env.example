# Development Environment Variables
# Copie este arquivo para .env.local e ajuste conforme necessário

# API URL - aponta para backend local
# Se seu backend ASP.NET roda em HTTPS na porta 7141, use:
VITE_API_URL=https://localhost:7141/api

# Ou se roda em HTTP na porta 5000:
# VITE_API_URL=http://localhost:5000/api
