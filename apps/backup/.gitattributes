# Auto detect text files and perform LF normalization
* text=auto

# Bash scripts should always use LF
*.sh text eol=lf

# PowerShell scripts
*.ps1 text eol=crlf

# Source code
*.cs text diff=csharp
*.csproj text
*.sln text eol=crlf

# Documentation
*.md text
*.txt text

# Docker
Dockerfile text
docker-compose.yml text

# Makefile must use tabs
Makefile text eol=lf

# Binary files
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
